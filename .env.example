# <your-habitica-user-id>-<appname>
# Get your User ID from https://habitica.com/user/settings/api
# Habitica requires this on every API request (see docs/habitica-api.md) —
# the app will refuse to make requests without it, rather than send a
# request Habitica would reject anyway.
VITE_HABITICA_CLIENT_ID=your-habitica-user-id-habitica-modern-frontend

# Port docker-compose publishes the app on (host side).
HOST_PORT=8080
